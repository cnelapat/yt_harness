__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# TELEMETRY — one record per gate run, including every red produced while
# iterating. High volume, disposable, regenerated on demand. Never committed.
.edad/records/

# EVIDENCE is the opposite and is deliberately NOT ignored: .edad/evidence/
# holds one record per ticket, the run in which it passed its full gate,
# promoted by the controller and committed beside the code it verifies.
# The ticket and its approval lock are committed too — they are the contract.

# Session logs are telemetry, like records. Worktrees are scratch.
.edad/sessions/
.edad/worktrees/

# Claude Code writes this per-machine during a session. Uncommitted it shows up
# as a stray in the agent's diff and trips the scope check on an innocent ticket.
# .claude/skills/ IS committed - the method ships with the harness.
.claude/settings.local.json
