# Sandbox for unattended runs. Built once. A ticket's `network_access: deny` is
# enforced on this container — `--network none`, or an internal net whose only
# way out is the CONNECT-allowlist proxy (edad/egress_proxy.py) — and advisory
# for the verifier, which runs on the host and sees only EDAD_NETWORK=deny.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git nodejs npm \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code
COPY requirements-gate.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-gate.txt
WORKDIR /work
